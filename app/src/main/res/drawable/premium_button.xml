<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <corners android:radius="32dp"/>

            <!-- Darker transparent purple -->
            <solid android:color="#403F1B8F"/>

            <stroke
                android:width="2dp"
                android:color="#A8C084FC"/>

        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">

            <corners android:radius="32dp"/>

            <!-- Light transparent purple -->
            <solid android:color="#263F1B8F"/>

            <stroke
                android:width="2dp"
                android:color="#70C084FC"/>

        </shape>
    </item>

</selector>